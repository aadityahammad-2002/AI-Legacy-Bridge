# Java repository data owner. Supply datasource credentials with environment variables.
spring.application.name=legacy-bridge-backend
spring.jpa.hibernate.ddl-auto=none
spring.jpa.open-in-view=false
spring.jpa.properties.hibernate.jdbc.batch_size=50
spring.jpa.properties.hibernate.order_inserts=true
spring.jpa.properties.hibernate.order_updates=true
spring.sql.init.mode=never
spring.flyway.enabled=true
spring.flyway.baseline-on-migrate=true
spring.flyway.baseline-version=1
spring.flyway.validate-on-migrate=true

# Local-only by default; frontends and the Python AI service run separately.
server.address=${SERVER_BIND_ADDRESS:127.0.0.1}
server.port=${SERVER_PORT:8080}
server.tomcat.threads.max=${SERVER_MAX_THREADS:80}
spring.datasource.hikari.maximum-pool-size=${DB_POOL_MAX:10}
spring.datasource.hikari.connection-timeout=15000

legacybridge.ai-service.base-url=${AI_SERVICE_BASE_URL:http://localhost:8001}
legacybridge.ai-service.connect-timeout-ms=${AI_CONNECT_TIMEOUT_MS:3000}
legacybridge.ai-service.read-timeout-ms=${AI_READ_TIMEOUT_MS:90000}
legacybridge.ai-jobs.poll-ms=${AI_SYNC_POLL_MS:3000}
legacybridge.ai-jobs.initial-delay-ms=5000
legacybridge.ai-jobs.lease-seconds=180
legacybridge.ai-jobs.max-attempts=8
legacybridge.cors.allowed-origins=${CORS_ALLOWED_ORIGINS:http://localhost:5173}

# Production diagnostics: only health/info exposed; no broad actuator exposure.
management.endpoints.web.exposure.include=health,info
management.endpoint.health.show-details=never
management.health.db.enabled=true

# Optional upper bound for advertised JSON request size (also enforce at reverse proxy).
legacybridge.ingest.max-request-bytes=${INGEST_MAX_REQUEST_BYTES:67108864}

# Disabled by default. Enable temporarily for a local manual DEAD INDEX replay.
# Do not commit or hard-code a replay token. Use environment variables only.
legacybridge.ai-jobs.replay-enabled=${LEGACYBRIDGE_REPLAY_ENABLED:false}
legacybridge.ai-jobs.replay-token=${LEGACYBRIDGE_REPLAY_TOKEN:}
