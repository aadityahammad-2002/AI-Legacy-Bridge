# AI Legacy Bridge — root Docker Compose configuration
# Copy to .env (gitignored), then replace placeholders with real credentials.
# NEVER commit .env or a real API key.

# PostgreSQL used by BOTH the Java and Python containers.
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Gemini (or another provider via the same environment variables).
LEGACYBRIDGE_LLM_API_KEY=PASTE_YOUR_GEMINI_API_KEY
LEGACYBRIDGE_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LEGACYBRIDGE_LLM_MODEL=gemini-3.5-flash-lite

# Optional Neo4j. Leave blank for PostgreSQL graph fallback.
# To enable: set a strong password (at least 8 chars) and use --profile graph.
NEO4J_PASSWORD=
